@@ -0,0 +1,168 @@
+import type { Plugin } from 'vite';
+import { getEnvironmentConsumer } from './environment.js';
+
+/**
+ * Options for Solid's capability linker (`solidCapabilities` from
+ * `@solidjs/compiler/capabilities`), which the plugin adds to production
+ * builds. Every field but `server` is forwarded to the linker as is.
+ */
+export interface CapabilitiesOptions {
+  /**
+   * Slice the runtime's link-time feature switches (`OPTIMISTIC`,
+   * `VERDICTS`, `STORES`, `SNAPSHOTS`, `ITERABLE`, `COMPILED_SEAMS`): each
+   * switch the module graph is proven not to use is compiled out of
+   * `@solidjs/signals`.
+   *
+   * @default true
+   */
+  features?: boolean;
+  /**
+   * Prove the feature switches from every application module's compiled
+   * output (what the bundle actually includes) rather than from its authored
+   * imports.
+   *
+   * @default true
+   */
+  compiledFacts?: boolean;
+  /**
+   * Whether this build's compiler passes may emit compiled seams.
+   *
+   * @default true
+   */
+  compiledSeams?: boolean;
+  /**
+   * `solid-tsc --capabilities` output (a path relative to the root, or the
+   * parsed object): typed facts that let more computations prove synchronous.
+   */
+  typedSummary?: string | object;
+  /** Write the linker's decision report to this path (relative to the root). */
+  report?: string;
+  /**
+   * Entry modules (relative to the root) when the build input does not name
+   * them. Builds normally need none: the linker reads the environment's
+   * build input, generated start-mode entries included.
+   */
+  entries?: string[];
+  /**
+   * Also link server (SSR) environments. Off by default: server bundles are
+   * not shipped to browsers, so slicing buys little there, and the runtime
+   * is often externalized from them, where the linker's resolution does not
+   * apply. Each environment is proven over its own graph, so turning this on
+   * never changes the client's decision.
+   *
+   * @default false
+   */
+  server?: boolean;
+}
+
+type LinkerOptions = Omit<CapabilitiesOptions, 'server'>;
+type LinkerFactory = (options?: LinkerOptions) => Plugin;
+
+const LINKER_NAME = 'solid:capabilities';
+// A variable specifier: `@solidjs/compiler` releases before the linker have
+// no `./capabilities` export, so neither TypeScript nor the bundler may
+// resolve it statically.
+const LINKER_MODULE = '@solidjs/compiler/capabilities';
+
+type LoadedLinker = { factory: LinkerFactory | null; error?: unknown };
+let linkerPromise: Promise<LoadedLinker> | undefined;
+// Once per process and level: builder mode re-resolves the config (and
+// this plugin) per environment.
+const reportedMissing = { info: false, warn: false };
+
+// A compiler without the subpath: expected (releases before the linker).
+const MISSING_CODES = new Set(['ERR_PACKAGE_PATH_NOT_EXPORTED', 'ERR_MODULE_NOT_FOUND']);
+
+/**
+ * The installed compiler's linker factory; null when it has none, with the
+ * error when loading failed for another reason.
+ */
+function loadLinker(): Promise<LoadedLinker> {
+  return (linkerPromise ??= import(/* @vite-ignore */ LINKER_MODULE).then(
+    (mod) => {
+      const factory = mod.solidCapabilities ?? mod.default?.solidCapabilities;
+      return typeof factory === 'function'
+        ? { factory: factory as LinkerFactory }
+        : { factory: null };
+    },
+    (error) => ({ factory: null, error: MISSING_CODES.has(error?.code) ? undefined : error }),
+  ));
+}
+
+/**
+ * Adds Solid's capability linker to production builds. The linker proves
+ * each environment's module graph and links `@solidjs/signals` against the
+ * smallest runtime that graph can use: the async-free entry when the graph
+ * is proven async-free, and every feature switch the graph is proven not to
+ * use compiled out (see `SolidCapabilitiesOptions` in
+ * `@solidjs/compiler/capabilities`). Anything unproven keeps the full
+ * runtime; the linker never guesses.
+ *
+ * Scope:
+ * - `vite build` only: the dev server's graph changes under HMR, so dev
+ *   (and vitest, which runs through the dev server) keeps the full runtime.
+ * - Client environments (`consumer: 'client'`) by default; server
+ *   environments with `server: true`.
+ * - One linker instance per environment (`applyToEnvironment`), so builder
+ *   mode (start, SSR) proves each graph with its own state even when the
+ *   rest of the plugin is shared across environments.
+ * - A config that already adds `solidCapabilities` itself keeps its own
+ *   instance, and this one stands down.
+ * - An installed `@solidjs/compiler` without the linker (releases before
+ *   it) builds as before: an info line by default, a warning when the
+ *   option was set explicitly or the module failed to load.
+ */
+export function solidCapabilitiesLinker(
+  option: boolean | CapabilitiesOptions | undefined,
+): Plugin | null {
+  if (option === false) return null;
+  const explicit = typeof option === 'object' && option !== null;
+  const { server = false, ...linkerOptions }: CapabilitiesOptions = explicit ? option : {};
+  return {
+    name: 'solid:capabilities-linker',
+    // Matches the linker's own `enforce`: the returned plugin takes this
+    // one's place in the sorted pipeline.
+    enforce: 'pre',
+    apply: 'build',
+    async applyToEnvironment(environment) {
+      const config = environment.config;
+      if (config.command !== 'build') return false;
+      const consumer = getEnvironmentConsumer(environment, { ssr: !!config.build?.ssr });
+      if (consumer === 'server' && !server) return false;
+      // A hand-wired linker (e.g. with a typed summary) wins. The top-level
+      // list: the environment's own is being resolved right now.
+      const plugins = environment.getTopLevelConfig().plugins;
+      if (plugins.some((plugin) => plugin.name === LINKER_NAME)) return false;
+      const loaded = await loadLinker();
+      if (!loaded.factory) {
+        const { error } = loaded;
+        const level = explicit || error ? 'warn' : 'info';
+        if (!reportedMissing[level]) {
+          reportedMissing[level] = true;
+          const cause = error ? ` Cause: ${error instanceof Error ? error.message : error}` : '';
+          const message =
+            (error
+              ? '[solid:capabilities] failed to load the capability linker (@solidjs/compiler/capabilities)'
+              : '[solid:capabilities] the installed @solidjs/compiler has no capability linker ' +
+                '(@solidjs/compiler/capabilities)') +
+            '; the build keeps the full Solid runtime. ' +
+            'Update @solidjs/compiler to slice it, or set `capabilities: false`.' +
+            cause;
+          config.logger[level](message);
+        }
+        return false;
+      }
+      const factory = loaded.factory;
+      const linker = factory(linkerOptions);
+      // Environment-scoped plugins do not receive the config-level hooks, and
+      // the linker reads its root, command and logger from `configResolved`.
+      const configResolved = linker.configResolved;
+      if (typeof configResolved === 'function') {
+        await (configResolved as (config: unknown) => unknown).call(linker, config);
+      } else if (configResolved && typeof configResolved.handler === 'function') {
+        await (configResolved.handler as (config: unknown) => unknown).call(linker, config);
+      }
+      return linker;
+    },
+  };
+}
