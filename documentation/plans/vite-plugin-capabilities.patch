+++ b/test/capabilities-missing.test.mjs
@@ -0,0 +1,45 @@
+// A compiler without the linker (`@solidjs/compiler` before
+// `./capabilities`): builds are unchanged, and say why once.
+import assert from 'node:assert/strict';
+import { register } from 'node:module';
+import { fileURLToPath } from 'node:url';
+import { test } from 'node:test';
+
+register('./fixtures/linker-hooks.mjs', import.meta.url, {
+  data: { target: new URL('./fixtures/no-linker.cjs', import.meta.url).href },
+});
+
+const { build, createLogger } = await import('vite');
+const { default: solid } = await import('../dist/esm/index.mjs');
+
+const root = fileURLToPath(new URL('./fixtures/capabilities-app/', import.meta.url));
+
+async function buildWith(pluginOptions) {
+  const messages = { info: [], warn: [] };
+  const logger = createLogger('info', { allowClearScreen: false });
+  logger.info = (msg) => messages.info.push(msg);
+  logger.warn = (msg) => messages.warn.push(msg);
+  const result = await build({
+    root,
+    configFile: false,
+    customLogger: logger,
+    plugins: [solid(pluginOptions)],
+    build: { write: false },
+  });
+  const outputs = (Array.isArray(result) ? result : [result]).flatMap((r) => r.output);
+  assert.ok(outputs.some((o) => o.type === 'chunk' && o.code.includes('42')));
+  const notice = (list) => list.filter((m) => m.includes('no capability linker'));
+  return { info: notice(messages.info), warn: notice(messages.warn) };
+}
+
+test('default: builds unchanged, an info line', async () => {
+  const { info, warn } = await buildWith();
+  assert.equal(info.length, 1);
+  assert.equal(warn.length, 0);
+});
+
+test('explicit options: builds unchanged, a warning', async () => {
+  const { info, warn } = await buildWith({ capabilities: { features: true } });
+  assert.equal(info.length, 0);
+  assert.equal(warn.length, 1);
+});
diff --git a/test/capabilities.test.mjs b/test/capabilities.test.mjs
new file mode 100644
index 0000000..aa14773
--- /dev/null
+++ b/test/capabilities.test.mjs
@@ -0,0 +1,136 @@
+// The capability linker wiring (`capabilities` option): which builds get
+// `solidCapabilities` from `@solidjs/compiler/capabilities`, with which
+// options. The linker itself is a fixture (fixtures/fake-linker.cjs) so the
+// test pins the plugin's wiring, not the installed compiler's proof.
+//
+// Needs the built plugin (`pnpm build`); run with `pnpm test:unit`.
+import assert from 'node:assert/strict';
+import { register } from 'node:module';
+import { fileURLToPath } from 'node:url';
+import { beforeEach, test } from 'node:test';
+
+register('./fixtures/linker-hooks.mjs', import.meta.url, {
+  data: { target: new URL('./fixtures/fake-linker.cjs', import.meta.url).href },
+});
+
+const { build, createBuilder, createServer } = await import('vite');
+const { default: solid } = await import('../dist/esm/index.mjs');
+
+const root = fileURLToPath(new URL('./fixtures/capabilities-app/', import.meta.url));
+const calls = (globalThis.__solidCapabilitiesCalls ??= []);
+// Vite resolves every environment's plugins with the config, built or not;
+// the linkers that took part in a build are the ones that matter.
+const built = () => calls.filter((call) => call.built);
+
+beforeEach(() => {
+  calls.length = 0;
+});
+
+async function buildApp(pluginOptions, config = {}) {
+  const result = await build({
+    root,
+    configFile: false,
+    logLevel: 'silent',
+    ...config,
+    plugins: [solid(pluginOptions), ...(config.plugins ?? [])],
+    build: { write: false, ...config.build },
+  });
+  const outputs = (Array.isArray(result) ? result : [result]).flatMap((r) => r.output);
+  return outputs
+    .filter((o) => o.type === 'chunk')
+    .map((o) => o.code)
+    .join('\n');
+}
+
+const serverBuild = { build: { ssr: 'server.js' } };
+
+test('client builds link by default', async () => {
+  const code = await buildApp();
+  assert.equal(built().length, 1);
+  assert.deepEqual(built()[0].options, {});
+  assert.equal(built()[0].built, true);
+  // The linker got the environment's resolved config (it reads the root,
+  // command and logger from configResolved).
+  assert.equal(built()[0].config.command, 'build');
+  assert.equal(built()[0].config.consumer, 'client');
+  assert.equal(built()[0].config.root, root.replace(/\/$/, ''));
+  assert.match(code, /linked:client/);
+});
+
+test('`capabilities: true` is the default', async () => {
+  const code = await buildApp({ capabilities: true });
+  assert.equal(built().length, 1);
+  assert.match(code, /linked:client/);
+});
+
+test('`capabilities: false` leaves the linker out', async () => {
+  const code = await buildApp({ capabilities: false });
+  assert.equal(calls.length, 0);
+  assert.doesNotMatch(code, /linked:/);
+});
+
+test('linker options are forwarded, `server` is not', async () => {
+  const options = { features: false, compiledFacts: false, report: 'report.json', server: false };
+  await buildApp({ capabilities: options });
+  assert.equal(built().length, 1);
+  assert.deepEqual(built()[0].options, {
+    features: false,
+    compiledFacts: false,
+    report: 'report.json',
+  });
+});
+
+test('server builds do not link by default', async () => {
+  const code = await buildApp({ ssr: true }, serverBuild);
+  assert.equal(built().length, 0);
+  assert.doesNotMatch(code, /linked:/);
+});
+
+test('`server: true` links server builds too', async () => {
+  const code = await buildApp({ ssr: true, capabilities: { server: true } }, serverBuild);
+  assert.equal(built().length, 1);
+  assert.equal(built()[0].config.consumer, 'server');
+  assert.match(code, /linked:server/);
+});
+
+test('builder mode: each client environment gets its own linker', async () => {
+  const builder = await createBuilder({
+    root,
+    configFile: false,
+    logLevel: 'silent',
+    plugins: [solid({ ssr: true })],
+    builder: {},
+    environments: {
+      client: { build: { write: false } },
+      ssr: { build: { write: false, rollupOptions: { input: 'server.js' } } },
+    },
+  });
+  await builder.buildApp();
+  assert.equal(builder.environments.ssr.isBuilt, true);
+  assert.deepEqual(
+    built().map((call) => [call.environment, call.config.consumer]),
+    [['client', 'client']],
+  );
+});
+
+test('a hand-wired linker wins', async () => {
+  const own = { name: 'solid:capabilities', enforce: 'pre' };
+  await buildApp(undefined, { plugins: [own] });
+  assert.equal(calls.length, 0);
+});
+
+test('the dev server keeps the full runtime', async () => {
+  const server = await createServer({
+    root,
+    configFile: false,
+    logLevel: 'silent',
+    server: { middlewareMode: true, ws: false },
+    plugins: [solid()],
+  });
+  try {
+    await server.environments.client.transformRequest('/main.js');
+  } finally {
+    await server.close();
+  }
+  assert.equal(calls.length, 0);
+});
