+
+function solidCapabilities(options = {}) {
+  const call = { options, config: null, built: false };
+  calls.push(call);
+  return {
+    name: 'solid:capabilities',
+    enforce: 'pre',
+    configResolved(config) {
+      call.config = { command: config.command, root: config.root, consumer: config.consumer };
+    },
+    buildStart() {
+      call.built = true;
+      call.environment = this.environment?.name;
+    },
+    transform(code, id) {
+      if (!id.endsWith('.js') || id.includes('node_modules')) return null;
+      return `${code}\nconsole.log(${JSON.stringify(`linked:${this.environment?.config?.consumer}`)});`;
+    },
+  };
+}
