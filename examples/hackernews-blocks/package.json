{
  "name": "hackernews-blocks-example",
  "description": "examples/hackernews (HackerNews as Solid Server Components over frame streams) with @solidjs/blocks (JSX flavor): same routes, frames wiring, markup and data",
  "version": "0.0.0",
  "private": true,
  "author": "Ryan Carniato",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.js",
    "test": "vitest run --config vitest.config.ts --maxWorkers=2",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "link": "solid-link",
    "link:check": "solid-link --check"
  },
  "dependencies": {
    "@solidjs/blocks": "workspace:*",
    "@solidjs/router": "2.0.0-next.29",
    "@solidjs/web": "workspace:*",
    "solid-js": "workspace:*"
  },
  "devDependencies": {
    "@solidjs/blocks-linker": "workspace:*",
    "@solidjs/vite-plugin": "3.0.0-next.35",
    "@types/node": "^25.6.0",
    "blocks-example-harness": "workspace:*",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.6"
  }
}
