{
  "name": "@solidjs/blocks-linker",
  "description": "The @solidjs/blocks type linker: joins what every render site passes into each component's props and writes declaration-merged prop colors (may be pending, may fail with E, live, static) that TypedProps reads. Vite plugin + `solid-link` CLI.",
  "version": "0.0.0",
  "author": "Ryan Carniato",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "solid-link": "./bin/solid-link.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "test": "vitest run --maxWorkers=2"
  },
  "dependencies": {
    "@solidjs/compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/blocks": "workspace:*",
    "@solidjs/web": "workspace:*",
    "solid-js": "workspace:*",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
